# ── Network ──────────────────────────────────────────────────────────────
PUBLIC_HOST=mcp.mysherah.com        # public hostname (Host allowlist + derived URLs)
#PUBLIC_BASE_URL=                   # override the derived https://$PUBLIC_HOST
PORT=3000
BIND_ADDR=127.0.0.1                 # keep on localhost behind nginx
#EXTRA_HOSTS=                       # comma-separated extra allowed Host values

# ── Identity / branding (defaults live in src/config.ts) ─────────────────
MCP_NAME=sherah                     # machine name (serverInfo.name)
MCP_TITLE=Sherah                    # human display name
MCP_DESCRIPTION=Online personal assistant for busy parents: home, kids, meals, admin and more
MCP_OPERATOR=Sherah
MCP_CONTACT_EMAIL=ben@medcalfsoftwaresolutions.com
MCP_WEBSITE_URL=https://mysherah.com
#MCP_REPOSITORY_URL=https://github.com/manbradcalf/sherah-mcp
#MCP_REPOSITORY_SOURCE=github
#MCP_ICON_URL=
#MCP_ICON_MIME=image/png
#MCP_CARD_NAME=                     # override derived reverse-DNS card name (com.mysherah/sherah)
#MCP_INSTRUCTIONS=                  # override the composed initialize instructions

# ── Sign-up intake (Xano) ────────────────────────────────────────────────
SHERAH_MCP_XANO_AUTH=               # sign-up tools reject submissions until set
SHERAH_MCP_SIGNUP_URL=https://api.mysherah.com/api:3xp2K03g/signup_with_task_requests
SHERAH_MCP_SIGNUP_INTEREST_URL=https://api.mysherah.com/api:3xp2K03g/signup_requests

# Server version comes from package.json — bump it there.
