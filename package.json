{
  "name": "sherah-mcp",
  "version": "0.1.0",
  "description": "Sherah's public, no-auth MCP server — a self-describing billboard endpoint discoverable by AI agents",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node build/server.js",
    "dev": "tsx watch src/server.ts",
    "inspect-local": "PUBLIC_HOST=localhost PORT=3000 npm run dev",
    "local-prod": "npm run build && PUBLIC_HOST=localhost PORT=3000 node --env-file=.env build/server.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@azure/monitor-opentelemetry": "^1.20.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/resources": "^2.11.0",
    "express": "^5.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
